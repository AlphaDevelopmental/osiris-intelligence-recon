# Copy to .env (git-ignored) and export, e.g.:  set -a; . ./.env; set +a
# The public OSIRIS GET routes used by this tool need no API key.

# OSIRIS deployment to query (default: https://osirisai.live)
OSIRIS_BASE_URL=https://osirisai.live

# Optional: one "Name: value" header for a self-hosted OSIRIS behind an authenticating
# reverse proxy. Never logged; redacted from reports. Not part of the OSIRIS API itself.
# OSIRIS_AUTH_HEADER=X-Proxy-Token: change-me
